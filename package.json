{
  "name": "ha-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "doppler run --no-fallback -- bun apps/worker/src/dev.ts",
    "build": "doppler run --no-fallback -- vp -C apps/web build",
    "start": "doppler run --no-fallback -- bun apps/web/server.ts",
    "worker:check": "doppler run --no-fallback -- bun apps/worker/src/main.ts",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test run",
    "verify": "vp run check && vp run test && vp run build",
    "drive:import": "doppler run --no-fallback -- bun apps/worker/src/import-drive.ts",
    "backend:start": "doppler run --no-fallback -- bun packages/backend/scripts/local-backend.ts",
    "backend:deploy": "doppler run --no-fallback -- mise exec -- node packages/backend/scripts/deploy.ts",
    "backend:verify": "doppler run --no-fallback -- bun packages/backend/scripts/verify-live.ts",
    "worker": "doppler run --no-fallback -- bun apps/worker/src/revisions.ts"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.4.2",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.11.0 <25"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
